@{
    ViewData["Title"] = "Start";
}

<div class="row g-4">
    <div class="col-lg-7">
        <h1>Tåg från Borås C</h1>
        <p class="ingress">
            Viskaexpressen kör till Göteborg, Varberg, Ulricehamn och Jönköping.
            Välj en avgång, peka ut en ledig plats i tåget och boka.
        </p>
        <a class="btn btn-vx" asp-controller="Home" asp-action="Avgangar">Se avgångar &rarr;</a>
    </div>
    <div class="col-lg-5">
        <div class="info-kort">
            <h2 class="h5">Har du redan bokat?</h2>
            <p class="text-muted">Skriv in bokningsnumret från din bekräftelse.</p>
            <form asp-controller="Bokning" asp-action="Hitta" method="get" class="d-flex gap-2">
                <input name="nummer" class="form-control" placeholder="VX-7K3Q92" maxlength="20"
                       aria-label="Bokningsnummer" required />
                <button type="submit" class="btn btn-vx-sekundar">Sök</button>
            </form>
        </div>
    </div>
</div>
