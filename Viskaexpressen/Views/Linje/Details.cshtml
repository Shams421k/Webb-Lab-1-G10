@model Linje
@{
    ViewData["Title"] = Model.Namn;
    var tagsatt = Model.Avgangar
        .Select(a => a.Tagsatt)
        .DistinctBy(t => t.Id)
        .OrderBy(t => t.Nummer)
        .ToList();
}

<p class="mb-3">
    <a asp-action="Index">Tillbaka till tåglinjer</a>
</p>

<article class="info-kort mb-4">
    <p class="mb-2"><span class="etikett @(Model.Tagtyp == "Express" ? "etikett-express" : null)">@Model.Tagtyp</span></p>
    <h1>@Model.Namn</h1>
    <p>@Model.Beskrivning</p>
    <div class="row g-3">
        <div class="col-sm-6">
            <p class="mb-1"><strong>Sträcka</strong></p>
            <p>@Model.Namn</p>
        </div>
        <div class="col-sm-6">
            <p class="mb-1"><strong>Tågtyp</strong></p>
            <p>@Model.Tagtyp</p>
        </div>
        <div class="col-sm-6">
            <p class="mb-1"><strong>Restid</strong></p>
            <p class="mb-0">@Model.RestidMinuter minuter</p>
        </div>
        <div class="col-sm-6">
            <p class="mb-1"><strong>Pris</strong></p>
            <p class="mb-0">@Model.Pris.ToString("0") kr</p>
        </div>
    </div>
    <a class="btn btn-vx mt-3" asp-controller="Avgang" asp-action="Index" asp-route-linjeId="@Model.Id">Visa avgångar</a>
</article>

<section aria-labelledby="tagsatt-rubrik">
    <h2 id="tagsatt-rubrik" class="avsnitt-rubrik">Tågsätt</h2>
    @if (tagsatt.Count == 0)
    {
        <p>Inga tågsätt är kopplade till den här linjen.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Tågnummer</th>
                        <th>Antal sittplatser</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var satt in tagsatt)
                    {
                        <tr>
                            <td>@satt.Nummer</td>
                            <td>@satt.AntalPlatser</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
