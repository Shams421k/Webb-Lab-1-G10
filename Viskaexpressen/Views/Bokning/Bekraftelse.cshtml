@model Bokning
@{
    ViewData["Title"] = "Bokningen är klar";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="info-kort">
            <h1 class="h3">Bokningen är klar</h1>
            <p class="text-muted">Spara bokningsnumret. Du behöver det för att hitta bokningen igen.</p>

            <div class="bokningsnummer">
                <span>Bokningsnummer</span>
                <strong>@Model.Bokningsnummer</strong>
            </div>

            <partial name="_BokningDetaljer" model="Model" />

            <a asp-action="Hitta" class="btn btn-vx-sekundar mt-2">Hitta en bokning</a>
            <a asp-controller="Home" asp-action="Avgangar" class="ms-3">Boka en till resa</a>
        </div>
    </div>
</div>
