@model ErrorViewModel
@{
    ViewData["Title"] = "Fel";
}

<h1>Något gick fel</h1>
<p class="ingress">Försök igen. Om det fortfarande inte fungerar kan du gå tillbaka till startsidan.</p>
<a class="btn btn-vx" asp-controller="Home" asp-action="Index">Till startsidan</a>

@if (Model.ShowRequestId)
{
    <p class="mt-3 text-muted">
        Felkod: <code>@Model.RequestId</code>
    </p>
}
