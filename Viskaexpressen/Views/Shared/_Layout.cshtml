@{
    var aktuellController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var aktuellAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Aktiv(string controller, string? action = null) =>
        aktuellController.Equals(controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || aktuellAction.Equals(action, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Viskaexpressen</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Viskaexpressen.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Viska<span>expressen</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#huvudmeny"
                        aria-controls="huvudmeny" aria-expanded="false" aria-label="Öppna menyn">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="huvudmeny">
                    <ul class="navbar-nav ms-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link @Aktiv("Home", "Index")" asp-controller="Home" asp-action="Index"
                               aria-current="@(Aktiv("Home", "Index") == "active" ? "page" : null)">Start</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Aktiv("Linje")" asp-controller="Linje" asp-action="Index"
                               aria-current="@(Aktiv("Linje") == "active" ? "page" : null)">Tåglinjer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Aktiv("Home", "Avgangar")" asp-controller="Home" asp-action="Avgangar"
                               aria-current="@(Aktiv("Home", "Avgangar") == "active" ? "page" : null)">Avgångar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Aktiv("Bokning", "Hitta")" asp-controller="Bokning" asp-action="Hitta"
                               aria-current="@(Aktiv("Bokning", "Hitta") == "active" ? "page" : null)">Hitta bokning</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 Viskaexpressen · 21WM1B, grupp G10 (Shams och Vincent)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
